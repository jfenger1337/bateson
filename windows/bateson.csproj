<Project Sdk="Microsoft.NET.Sdk">
  <!-- bateson for Windows: WinForms and WebView2 around the web UI. ./build.ps1 builds it; see App.cs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 (Windows 10 2004) for the toast notifications; WebView2 comes with Windows 10 and 11. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bateson</AssemblyName>
    <RootNamespace>Bateson</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.0</Version>
    <Product>bateson</Product>
    <!-- So it also builds (not runs) on a Mac or Linux, as a check. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The WebView2 package also brings its WPF control, whose WindowsBase this WinForms app never loads. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same sound and icon as the Mac app. -->
    <EmbeddedResource Include="../mac/Notify.wav" LogicalName="Notify.wav" />
    <Content Include="../mac/AppIcon.png" Link="AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
