{
  "name": "bateson",
  "private": true,
  "version": "0.1.0",
  "description": "A local review queue for the calls your coding agent should not make alone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfenger1337/bateson.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "bin": {
    "bateson": "cli/bateson.mjs"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "node server/server.mjs",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@radix-ui/react-context-menu": "^2.4.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.72.0",
    "marked": "^18.1.3",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
